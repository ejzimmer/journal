{
  "name": "journal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.2.2",
    "@babel/core": "^7.16.0",
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@pmmmwh/react-refresh-webpack-plugin": "0.6.3",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "19",
    "babel-jest": "30.5.1",
    "babel-loader": "10.1.1",
    "babel-plugin-named-asset-import": "^0.3.8",
    "babel-preset-react-app": "^10.0.1",
    "bfj": "9.1.3",
    "browserslist": "^4.18.1",
    "camelcase": "9.0.0",
    "case-sensitive-paths-webpack-plugin": "^2.4.0",
    "css-loader": "7.1.5",
    "css-minimizer-webpack-plugin": "8.0.0",
    "dotenv": "18.0.0",
    "dotenv-expand": "1000.0.0",
    "eslint": "^10.9.1",
    "eslint-webpack-plugin": "^6.0.0",
    "file-loader": "^6.2.0",
    "firebase": "^12.17.1",
    "fs-extra": "11.4.0",
    "html-webpack-plugin": "^5.5.0",
    "idb-keyval": "^6.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "30.5.1",
    "jest-resolve": "^30.5.1",
    "jest-watch-typeahead": "^3.0.1",
    "jsdom": "30.1.0",
    "jsonc-parser": "^3.3.1",
    "mini-css-extract-plugin": "^2.4.5",
    "next-themes": "^0.4.6",
    "planck": "^1.5.0",
    "postcss": "^8.4.4",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-loader": "8.2.1",
    "postcss-normalize": "13.0.1",
    "postcss-preset-env": "11.5.3",
    "prompts": "^2.4.2",
    "react": "^19.1.0",
    "react-app-polyfill": "^3.0.0",
    "react-dev-utils": "^12.0.1",
    "react-dom": "19",
    "react-refresh": "0.19.0",
    "react-router-dom": "^7.18.4",
    "resolve-url-loader": "5.0.0",
    "sass-loader": "17.0.1",
    "semver": "^7.3.5",
    "source-map-loader": "5.0.0",
    "style-loader": "4.0.0",
    "terser-webpack-plugin": "^5.2.5",
    "tiny-invariant": "^1.3.3",
    "typescript": "^6.0.3",
    "web-vitals": "6.2.2",
    "webpack": "^5.64.4",
    "webpack-dev-server": "6.0.0",
    "webpack-manifest-plugin": "6.0.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-webpack-plugin": "7.4.1"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "start:mock": "REACT_APP_USE_MOCK_FIREBASE=true node scripts/start.js",
    "build": "node scripts/build.js",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "setupFiles": [
      "react-app-polyfill/jsdom"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ],
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(js|jsx|mjs|cjs|ts|tsx)$": "<rootDir>/config/jest/babelTransform.js",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|mjs|cjs|ts|tsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "modulePaths": [],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy",
      "^@ark-ui/react/(.*)$": [
        "<rootDir>/node_modules/@ark-ui/react/dist/components/$1/index.cjs",
        "<rootDir>/node_modules/@ark-ui/react/dist/components/$1.cjs",
        "<rootDir>/node_modules/@ark-ui/react/dist/providers/$1/index.cjs",
        "<rootDir>/node_modules/@ark-ui/react/dist/providers/$1.cjs"
      ],
      "^.+\\.css$": "<rootDir>/config/CSSStub.js"
    },
    "moduleFileExtensions": [
      "web.js",
      "js",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ],
    "watchPlugins": [
      "jest-watch-typeahead/filename",
      "jest-watch-typeahead/testname"
    ],
    "resetMocks": true
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "confusing-browser-globals": "^1.0.11",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jest-environment-jsdom": "^30.0.5",
    "prettier": "^3.9.8",
    "typescript-eslint": "^8.68.0"
  }
}
