{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/no-history-comments.sh\"",
            "timeout": 15,
            "statusMessage": "Checking staged comments for history-narrating language..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 300,
            "statusMessage": "Selecting the pinned Node version and installing dependencies..."
          }
        ]
      }
    ]
  }
}
